# Data files — too large for GitHub, kept locally only
# 'data/*' rather than 'data/': git never looks inside a directory it has
# excluded outright, so a negation for data/deploy would have no effect.
data/*
# The slim subset the deployed dashboard reads, built by
# scripts/export_dashboard_data.py (~30 MB of parquet).
!data/deploy/
*.nc
*.grib
*.grib2
*.h5
*.hdf5
refrences/notes/  
refrences/study-ref/

# macOS
.DS_Store

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
# Source documents from supervisors stay out; generated summaries are
# deliverables and belong in the repository.
*.docx
!summaries/*.docx
comments-outline17042026.txt
Shell\ commands.rtf
# Generated figures are local-only, except the quantile-mapping set, which is
# embedded in summaries/quantile_mapping_findings.md and must render on GitHub.
plots/*
!plots/fig_q*.png
history/

# Reference articles (PDFs are publisher copies, kept locally only)
articles/

# The global gitignore excludes .claude/, but CLAUDE.md is project
# documentation and belongs in the repository. A parent directory cannot be
# un-ignored by a negation alone, so re-include the directory, exclude its
# contents, then re-include the one file. settings.local.json stays out: it is
# per-machine.
!.claude/
.claude/*
!.claude/CLAUDE.md
